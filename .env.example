# Bot token from https://discord.com/developers (Bot tab -> Reset Token)
DISCORD_TOKEN=paste-your-bot-token-here

# Base url the bot looks up users/items/games through.
#
# Deploy the proxy first (see README, "Deploy the proxy on Render"), then
# point this at your Render service, e.g.:
#   MADXKA_BASE_URL=https://madxka-proxy.onrender.com
#
# The proxy is what serves the verified/admin badge images
# ({base}/badges/*.svg). If you point the bot at https://madxka.com
# directly, lookups still work but badges will not show.
MADXKA_BASE_URL=https://madxka.com

# Optional: set to your server ID to sync commands instantly while
# developing. Leave empty for global sync (can take a few minutes).
DISCORD_GUILD_ID=

# Optional: your madxka.com browser cookie, so the proxy acts as your
# logged-in account. To get it: open madxka.com in a browser, press F12,
# go to the Network tab, click any request, and copy the full "cookie"
# value from the request headers. Leave empty if you don't need it.
MADXKA_COOKIE=
